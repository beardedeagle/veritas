# The Veritas server: the web surface, the CMDB, and the datastore it
# supervises. The datastore is a child of the node, not a separate unit:
# ADR-048 puts it in the node's own supervision tree, so it starts with the
# node and stops with it.
#
# Install:  ops/install.sh
# Runbook:  ops/RUNBOOK.md

[Unit]
Description=Veritas Server
Documentation=file:///opt/veritas/ops/RUNBOOK.md
After=network-online.target time-sync.target
Wants=network-online.target
Requires=time-sync.target
ConditionPathExists=/etc/veritas/veritas.conf

[Service]
Type=notify
User=veritas
Group=veritas
Environment=HOME=/var/lib/veritas
Environment=VERITAS_ROLE=server
EnvironmentFile=-/etc/veritas/veritas.env
WorkingDirectory=/var/lib/veritas
ExecStart=/opt/veritas/bin/veritas start
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=60s
KillSignal=SIGTERM
KillMode=mixed
OOMPolicy=stop
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=0
TasksMax=32768
LimitNOFILE=1048576
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/veritas /var/log/veritas
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=veritas

[Install]
WantedBy=multi-user.target

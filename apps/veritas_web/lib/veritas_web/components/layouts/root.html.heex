<!DOCTYPE html>
<html lang="en" data-theme="dark" data-density={assigns[:shell][:density] || "comfortable"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Veritas" suffix=" · Veritas" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta
      name="description"
      content="Veritas — a self-hosted, agentic ITSM and CMDB service. Incident, Service Request, Change, Problem, Vulnerability and Configuration Item, with an append-only Audit Log."
    />
    <link rel="icon" type="image/svg+xml" href="/images/veritas-icon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.detail || e.target?.dataset?.phxTheme || "system"));

        // The theme buttons live in the shell, which the root layout renders
        // around the page — outside any LiveView's DOM, so LiveView cannot
        // see a click on them. The theme is a property of the document, so
        // the document listens for it.
        document.addEventListener("click", (e) => {
          const button = e.target.closest && e.target.closest("[data-phx-theme]");
          if (button) setTheme(button.dataset.phxTheme);
        });

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    <Veritas.Web.ShellComponents.shell shell={assigns[:shell]} conn={@conn}>
      {@inner_content}
    </Veritas.Web.ShellComponents.shell>

    <script>
      (() => {
        const toggle = document.getElementById("veritas-rail-toggle");
        if (!toggle) return;

        const key = "veritas:rail-collapsed";
        const setCollapsed = (collapsed) => {
          document.documentElement.dataset.railCollapsed = String(collapsed);
          toggle.setAttribute("aria-expanded", String(!collapsed));
          toggle.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
          toggle.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
        };

        let preference;
        try { preference = localStorage.getItem(key); } catch {}
        setCollapsed(preference === "true" || (preference !== "false" && matchMedia("(max-width: 900px)").matches));

        toggle.addEventListener("click", () => {
          const collapsed = document.documentElement.dataset.railCollapsed !== "true";
          setCollapsed(collapsed);
          try { localStorage.setItem(key, String(collapsed)); } catch {}
        });
      })();
    </script>

    <script>
      (() => {
        const palette = document.getElementById("v-command-palette");
        if (!palette) return;

        const input = document.getElementById("v-command-input");
        const results = document.getElementById("v-command-results");
        const items = Array.from(palette.querySelectorAll("[data-command]"));
        let matches = [];

        const setOpen = (open) => {
          results.hidden = !open;
          input.setAttribute("aria-expanded", String(open));
        };

        document.addEventListener("keydown", (event) => {
          if ((event.metaKey || event.ctrlKey) && (event.key === "k" || event.key === "K")) {
            event.preventDefault();
            input.focus();
            input.select();
            setOpen(true);
            return;
          }
          if (event.key === "Escape" && !results.hidden) {
            event.preventDefault();
            input.focus();
            setOpen(false);
          }
        });

        input.addEventListener("input", () => {
          const needle = input.value.trim().toLowerCase();
          matches = items.filter((item) => {
            const haystack = ((item.dataset.command || "") + " " + item.textContent).toLowerCase();
            return needle.length > 0 && haystack.includes(needle);
          });
          items.forEach((item) => {
            item.hidden = matches.length > 0 && !matches.includes(item);
          });
          setOpen(true);
        });

        input.addEventListener("focus", () => setOpen(true));
        input.addEventListener("click", () => setOpen(true));
        input.addEventListener("keydown", (event) => {
          const first = (event.key === "Enter" ? matches[0] : items.find((item) => !item.hidden))?.querySelector("a");
          if (first && (event.key === "Enter" || event.key === "ArrowDown")) {
            event.preventDefault();
            if (event.key === "Enter") first.click();
            else {
              setOpen(true);
              first.focus();
            }
          }
        });

        document.addEventListener("pointerdown", (event) => {
          if (!palette.contains(event.target)) setOpen(false);
        });
        palette.addEventListener("focusout", (event) => {
          if (!palette.contains(event.relatedTarget)) setOpen(false);
        });

        items.forEach((item) => item.addEventListener("click", () => setOpen(false)));
      })();
    </script>
  </body>
</html>

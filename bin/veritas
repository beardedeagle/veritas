#!/bin/sh
# bin/veritas — the release's start script.
#
# In a **release**, this file *is* the release's start script — `start`,
# `stop`, `rpc`, `eval`, `remote` — generated by `mix release` and shipped
# inside the release directory (`docs/10` §Release Artifact Layout). The
# release's Windows twin is `bin/veritas.bat`.
#
# In a **checkout** there is no release yet, so this script finds the one
# that was built and hands the command to it. The development entry point —
# the Mix tasks, `mix veritas.cli` and the rest — is `bin/veritas-dev`, so
# that one name means one thing.
#
#     mix release
#     bin/veritas start
#     bin/veritas stop

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for candidate in \
  "$root/_build/prod/rel/veritas/bin/veritas" \
  "$root/_build/dev/rel/veritas/bin/veritas"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "bin/veritas: there is no release to run." >&2
echo "bin/veritas: build one with 'mix release'." >&2
echo "bin/veritas: for the development entry point, use 'bin/veritas-dev'." >&2
exit 127

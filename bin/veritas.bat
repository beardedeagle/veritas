@echo off
rem bin\veritas.bat — the release's start script, on Windows.
rem
rem In a **release**, this file *is* the release's start script — `start`,
rem `stop`, `rpc`, `eval`, `remote` — generated by `mix release` and shipped
rem inside the release directory (docs/10 §Release Artifact Layout).
rem
rem In a **checkout** there is no release yet, so this script finds the one
rem that was built and hands the command to it. The development entry point —
rem the Mix tasks, `mix veritas.cli` and the rest — is `bin\veritas-dev`, so
rem that one name means one thing.
rem
rem     mix release
rem     bin\veritas start
rem     bin\veritas stop

setlocal
set ROOT=%~dp0..

if exist "%ROOT%\_build\prod\rel\veritas\bin\veritas.bat" (
  call "%ROOT%\_build\prod\rel\veritas\bin\veritas.bat" %*
  exit /b %ERRORLEVEL%
)

if exist "%ROOT%\_build\dev\rel\veritas\bin\veritas.bat" (
  call "%ROOT%\_build\dev\rel\veritas\bin\veritas.bat" %*
  exit /b %ERRORLEVEL%
)

echo bin\veritas: there is no release to run. 1>&2
echo bin\veritas: build one with 'mix release'. 1>&2
echo bin\veritas: for the development entry point, use 'bin\veritas-dev'. 1>&2
exit /b 127
